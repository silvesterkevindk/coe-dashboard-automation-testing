# ------------------------------------------------------------------
# Env untuk produksi (Vercel). Di lokal boleh dikosongkan — aplikasi
# otomatis pakai file SQLite lokal (server/coe.db).
# ------------------------------------------------------------------

# Database Turso (libSQL). Ambil dari: turso db show <db> --url
TURSO_DATABASE_URL=

# Auth token Turso. Ambil dari: turso db tokens create <db>
TURSO_AUTH_TOKEN=

# Secret untuk sign JWT — WAJIB diisi teks acak panjang di produksi
JWT_SECRET=
